    "version": "0.2.0",
    "configurations": [
        {
            "cwd": "${workspaceRoot}",
            "executable": "build/${env:NAME_PROJECT}.elf",
            "showDevDebugOutput": "raw",
            "name": "Debug_",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "stlink",
            //"serverpath":"C:/ST2/STM32CubeIDE_1.9.0/STM32CubeIDE/plugins/com.st.stm32cube.ide.mcu.externaltools.stlink-gdb-server.win32_2.0.200.202202231230/tools/bin/ST-LINK_gdbserver.exe",
            "serverpath": "${env:TOOLCHAIN_ST_LINK}/ST-LINK_gdbserver.exe",
            "stm32cubeprogrammer":"${env:STM32CUBE_PROGRAMMER}",
            "armToolchainPath": "${env:ARM_TOOLCHAIN_PATH}",
            "device": "STM32F429ZI",
            "interface": "swd",
            "runToEntryPoint": "main",  // Replaced 'runToMain' with 'runToEntryPoint'
            "svdFile": "${workspaceRoot}/Driver/STM32F429/STM32F429.svd",

        }
    ]
}